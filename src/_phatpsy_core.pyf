python module _phatpsy_core
    interface
        module phatpsy_state_mod
            use iso_fortran_env, only: real64, real32, int32
            integer(kind=int32) :: natom, nelem, norbt, mstot, ncycl
            real(kind=real64) :: tmole, totke, totpe, zzpot, deltae, cdamp, vdamp
            logical(kind=1) :: qcheck, qatom, qopen, qfirst, qlast, qprint, qewmo, qdebug, qtrace
            subroutine init_block_data_and_defaults
            end subroutine init_block_data_and_defaults
            subroutine compute_derived_dimensions_and_allocate
            end subroutine compute_derived_dimensions_and_allocate
            subroutine get_evalx(out_eval, n, nspin)
                integer intent(in) :: n, nspin
                real(kind=real64) intent(out), dimension(n, nspin) :: out_eval
            end subroutine get_evalx
            subroutine get_occx(out_occ, n, nspin)
                integer intent(in) :: n, nspin
                real(kind=real64) intent(out), dimension(n, nspin) :: out_occ
            end subroutine get_occx
            subroutine get_evecx(out_evec, m, n, nspin)
                integer intent(in) :: m, n, nspin
                real(kind=real64) intent(out), dimension(m, n, nspin) :: out_evec
            end subroutine get_evecx
            subroutine get_ovlp(out_ovlp, n2, nspin)
                integer intent(in) :: n2, nspin
                real(kind=real64) intent(out), dimension(n2, nspin) :: out_ovlp
            end subroutine get_ovlp
            subroutine get_ewmat(out_ewmat, n2, nspin)
                integer intent(in) :: n2, nspin
                real(kind=real64) intent(out), dimension(n2, nspin) :: out_ewmat
            end subroutine get_ewmat
        end module phatpsy_state_mod

        module phatpsy_contrl_mod
            use iso_fortran_env, only: real64, real32, int32
            subroutine contrl_read_control_input(eof_reached)
                logical intent(out) :: eof_reached
            end subroutine contrl_read_control_input
            subroutine contrl_init_tables
            end subroutine contrl_init_tables
            subroutine contrl_init_elements(eof_reached)
                logical intent(out) :: eof_reached
            end subroutine contrl_init_elements
            subroutine contrl_step_aloop_and_ewmo(converged_or_done)
                logical intent(out) :: converged_or_done
            end subroutine contrl_step_aloop_and_ewmo
            subroutine contrl_step_scf(done_after_scf)
                logical intent(out) :: done_after_scf
            end subroutine contrl_step_scf
        end module phatpsy_contrl_mod

        module phatpsy_scf_mod
            use iso_fortran_env, only: real64, int32
            logical :: use_lapack_eig
            real(kind=real64) :: fock_mix_alpha
        end module phatpsy_scf_mod

        module phatpsy_analys_mod
            logical :: use_lapack_fit
        end module phatpsy_analys_mod

        module phatpsy_integrals_mod
            logical :: use_in_memory_tei
            subroutine clear_tei_cache
            end subroutine clear_tei_cache
        end module phatpsy_integrals_mod

        module phatpsy_ewmo_mod
            use iso_fortran_env, only: real64, int32
            logical(kind=1) :: qnopop_ewmo
            logical :: use_lowdin_ewmo
        end module phatpsy_ewmo_mod
    end interface
end python module _phatpsy_core
