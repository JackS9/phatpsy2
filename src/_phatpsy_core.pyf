python module _phatpsy_core
    interface
        module state
            use iso_fortran_env, only: real64, real32, int32
            integer(kind=int32) :: natom, nelem, norbt, mstot, ncycl
            real(kind=real64) :: tmole, totke, totpe, zzpot, deltae, cdamp, vdamp
            logical(kind=1) :: qcheck, qatom, qopen, qfirst, qlast, qprint, qewmo, qdebug, qtrace
            subroutine init_block_data_and_defaults
            end subroutine init_block_data_and_defaults
            subroutine compute_derived_dimensions_and_allocate
            end subroutine compute_derived_dimensions_and_allocate
            subroutine get_evalx(out_eval, n, nspin)
                integer intent(in) :: n, nspin
                real(kind=real64) intent(out), dimension(n, nspin) :: out_eval
            end subroutine get_evalx
            subroutine get_occx(out_occ, n, nspin)
                integer intent(in) :: n, nspin
                real(kind=real64) intent(out), dimension(n, nspin) :: out_occ
            end subroutine get_occx
            subroutine get_evecx(out_evec, m, n, nspin)
                integer intent(in) :: m, n, nspin
                real(kind=real64) intent(out), dimension(m, n, nspin) :: out_evec
            end subroutine get_evecx
            subroutine get_ovlp(out_ovlp, n2, nspin)
                integer intent(in) :: n2, nspin
                real(kind=real64) intent(out), dimension(n2, nspin) :: out_ovlp
            end subroutine get_ovlp
            subroutine get_ewmat(out_ewmat, n2, nspin)
                integer intent(in) :: n2, nspin
                real(kind=real64) intent(out), dimension(n2, nspin) :: out_ewmat
            end subroutine get_ewmat
            subroutine get_coord(out_coord, n3, n)
                integer intent(in) :: n3, n
                real(kind=real64) intent(out), dimension(n3, n) :: out_coord
            end subroutine get_coord
            subroutine get_charge(out_charge, n3, n)
                integer intent(in) :: n3, n
                real(kind=real64) intent(out), dimension(n3, n) :: out_charge
            end subroutine get_charge
            subroutine set_charge(in_charge, n3, n)
                integer optional, depend(in_charge) :: n3 = shape(in_charge, 0)
                integer optional, depend(in_charge) :: n = shape(in_charge, 1)
                real(kind=real64) intent(in), dimension(n3, n) :: in_charge
            end subroutine set_charge
            subroutine get_popul(out_popul, n, nspin)
                integer intent(in) :: n, nspin
                real(kind=real64) intent(out), dimension(n, nspin) :: out_popul
            end subroutine get_popul
            subroutine set_popul(in_popul, n, nspin)
                integer optional, depend(in_popul) :: n = shape(in_popul, 0)
                integer optional, depend(in_popul) :: nspin = shape(in_popul, 1)
                real(kind=real64) intent(in), dimension(n, nspin) :: in_popul
            end subroutine set_popul
            subroutine get_iatomx(out_iatom, m)
                integer intent(in) :: m
                integer(kind=int32) intent(out), dimension(m) :: out_iatom
            end subroutine get_iatomx
            subroutine get_nx(out_n, m)
                integer intent(in) :: m
                integer(kind=int32) intent(out), dimension(m) :: out_n
            end subroutine get_nx
            subroutine get_lx(out_l, m)
                integer intent(in) :: m
                integer(kind=int32) intent(out), dimension(m) :: out_l
            end subroutine get_lx
            subroutine get_mlx(out_ml, m)
                integer intent(in) :: m
                integer(kind=int32) intent(out), dimension(m) :: out_ml
            end subroutine get_mlx
            subroutine get_etax(out_eta, m)
                integer intent(in) :: m
                real(kind=real64) intent(out), dimension(m) :: out_eta
            end subroutine get_etax
            subroutine get_anormx(out_anorm, m)
                integer intent(in) :: m
                real(kind=real64) intent(out), dimension(m) :: out_anorm
            end subroutine get_anormx
            subroutine reset_cycle_diagnostics
            end subroutine reset_cycle_diagnostics
            subroutine get_cycle_diagnostics(pk_penalty, rms_coulomb, rms_exchange, charge_transfer)
                real(kind=real64) intent(out) :: pk_penalty
                real(kind=real64) intent(out) :: rms_coulomb
                real(kind=real64) intent(out) :: rms_exchange
                real(kind=real64) intent(out) :: charge_transfer
            end subroutine get_cycle_diagnostics
        end module state

        module contrl
            use iso_fortran_env, only: real64, real32, int32
            subroutine contrl_read_control_input(eof_reached)
                logical intent(out) :: eof_reached
            end subroutine contrl_read_control_input
            subroutine contrl_init_tables
            end subroutine contrl_init_tables
            subroutine contrl_init_elements(eof_reached)
                logical intent(out) :: eof_reached
            end subroutine contrl_init_elements
            subroutine contrl_step_aloop_and_ewmo(converged_or_done)
                logical intent(out) :: converged_or_done
            end subroutine contrl_step_aloop_and_ewmo
            subroutine contrl_step_scf(done_after_scf)
                logical intent(out) :: done_after_scf
            end subroutine contrl_step_scf
        end module contrl

        module scf
            use iso_fortran_env, only: real64, int32
            logical :: use_lapack_eig
            real(kind=real64) :: fock_mix_alpha
        end module scf

        module analys
            logical :: use_lapack_fit
        end module analys

        module integrals
            logical :: use_in_memory_tei
            subroutine clear_tei_cache
            end subroutine clear_tei_cache
        end module integrals

        module ewmo
            use iso_fortran_env, only: real64, int32
            logical(kind=1) :: qnopop_ewmo
            logical :: use_lowdin_ewmo
            subroutine solve_fermi_level(evals, occs, norb, nelec, theta, fermi_mu)
                use iso_fortran_env, only: real64, int32
                integer(kind=int32) intent(in) :: norb
                real(kind=real64) intent(in), dimension(norb) :: evals
                real(kind=real64) intent(out), dimension(norb), depend(norb) :: occs
                real(kind=real64) intent(in) :: nelec
                real(kind=real64) intent(in) :: theta
                real(kind=real64) intent(out), optional :: fermi_mu
            end subroutine solve_fermi_level
        end module ewmo

        module modelpot
            use iso_fortran_env, only: real64, int32
            subroutine genfac(fact, nfact)
                integer(kind=int32) intent(in) :: nfact
                real(kind=real64) intent(out), dimension(nfact) :: fact
            end subroutine genfac
            subroutine genbc(binom, nbinom, nrows, index_arr)
                integer(kind=int32) intent(in) :: nbinom, nrows
                integer(kind=int32) intent(in), dimension(nrows) :: index_arr
                real(kind=real64) intent(out), dimension(nbinom) :: binom
            end subroutine genbc
            subroutine gennrm_default(plmnrm, fact, nplm, nfact, lmax, qrealy)
                integer(kind=int32) intent(in) :: nplm, nfact, lmax
                logical intent(in) :: qrealy
                real(kind=real64) intent(in), dimension(nfact) :: fact
                real(kind=real64) intent(out), dimension(nplm) :: plmnrm
            end subroutine gennrm_default
            subroutine intnrm(evec, projec, scrat, nbas, nvec, n2bas)
                integer(kind=int32) intent(in) :: nbas, nvec, n2bas
                real(kind=real64) intent(in), dimension(n2bas) :: projec
                real(kind=real64) intent(in,out), dimension(nbas, nvec) :: evec
                real(kind=real64) intent(out), dimension(nbas, nbas) :: scrat
            end subroutine intnrm
            subroutine dampv(epot2, pkpot, zpot2, vpot2, msto, m2sto, nvterm, ispin, vdamp)
                integer(kind=int32) intent(in) :: msto, m2sto, nvterm, ispin
                real(kind=real64) intent(in) :: vdamp
                real(kind=real64) intent(in,out), dimension(m2sto, ispin) :: epot2
                real(kind=real64) intent(in,out), dimension(m2sto, 4, ispin) :: pkpot
                real(kind=real64) intent(in,out), dimension(m2sto) :: zpot2
                real(kind=real64) intent(in,out), dimension(nvterm) :: vpot2
            end subroutine dampv
            subroutine scale_screening_exponents(vexp_base, vexp_scaled, nvterm, znuc, q_charge, gamma_param)
                use iso_fortran_env, only: real64, int32
                integer(kind=int32) intent(hide), depend(vexp_base) :: nvterm = len(vexp_base)
                real(kind=real64) intent(in), dimension(nvterm) :: vexp_base
                real(kind=real64) intent(out), dimension(nvterm), depend(nvterm) :: vexp_scaled
                real(kind=real64) intent(in) :: znuc
                real(kind=real64) intent(in) :: q_charge
                real(kind=real64) intent(in), optional :: gamma_param = 1.0
            end subroutine scale_screening_exponents
            subroutine update_dynamic_exponents(gamma_param)
                use iso_fortran_env, only: real64, int32
                real(kind=real64) intent(in), optional :: gamma_param = 1.0
            end subroutine update_dynamic_exponents
        end module modelpot

        module linalg
            use iso_fortran_env, only: real64, int32
            subroutine trisq(n, h, u, result)
                integer(kind=int32) intent(in) :: n
                real(kind=real64) intent(in), dimension((n*(n+1))/2) :: h
                real(kind=real64) intent(in), dimension(n, n) :: u
                real(kind=real64) intent(out), dimension(n, n) :: result
            end subroutine trisq
            subroutine tritri(a, b, ab, n, n2)
                integer(kind=int32) intent(in) :: n, n2
                real(kind=real64) intent(in), dimension(n2) :: a
                real(kind=real64) intent(in), dimension(n2) :: b
                real(kind=real64) intent(out), dimension(n, n) :: ab
            end subroutine tritri
            subroutine uthu(n, h, u, scrat, result)
                integer(kind=int32) intent(in) :: n
                real(kind=real64) intent(in), dimension((n*(n+1))/2) :: h
                real(kind=real64) intent(in), dimension(n, n) :: u
                real(kind=real64) intent(out), dimension(n, n) :: scrat
                real(kind=real64) intent(out), dimension((n*(n+1))/2) :: result
            end subroutine uthu
            subroutine invert(matrix, invers, nsize, ierror, nrow, ncolum)
                integer(kind=int32) intent(in) :: nsize, nrow, ncolum
                real(kind=real64) intent(in), dimension(nrow, ncolum) :: matrix
                real(kind=real64) intent(out), dimension(nrow, ncolum) :: invers
                integer(kind=int32) intent(out) :: ierror
            end subroutine invert
            subroutine matinv(a, n, b, m, determ)
                integer(kind=int32) intent(in) :: n, m
                real(kind=real64) intent(in,out), dimension(n, n) :: a
                real(kind=real64) intent(in,out), dimension(n, m) :: b
                real(kind=real64) intent(out) :: determ
            end subroutine matinv
            subroutine schmid(s, nrows)
                integer(kind=int32) intent(in) :: nrows
                real(kind=real64) intent(in,out), dimension((nrows*(nrows+1))/2) :: s
            end subroutine schmid
            subroutine normlz(evec, nvec, ovrlap, nbas, n2bas)
                integer(kind=int32) intent(in) :: nvec, nbas, n2bas
                real(kind=real64) intent(in,out), dimension(nbas, nvec) :: evec
                real(kind=real64) intent(in), dimension(n2bas) :: ovrlap
            end subroutine normlz
            function round(x, n) result (round)
                double precision intent(in) :: x
                integer intent(in) :: n
                double precision :: round
            end function round
            subroutine maxovl(iorder, evec1, evec2, ovlp, nbas, n2bas, nvec, qnword)
                integer(kind=int32) intent(in) :: nbas, n2bas, nvec
                real(kind=real64) intent(in), dimension(nbas, nvec) :: evec1
                real(kind=real64) intent(in), dimension(nbas, nvec) :: evec2
                real(kind=real64) intent(in), dimension(n2bas) :: ovlp
                integer(kind=int32) intent(out), dimension(nvec) :: iorder
                logical intent(out) :: qnword
            end subroutine maxovl
            subroutine hesbrg(a, n, mpr)
                integer(kind=int32) intent(in) :: n
                real(kind=real64) intent(in,out), dimension(n, n) :: a
                integer(kind=int32) intent(out), dimension(n) :: mpr
            end subroutine hesbrg
            subroutine norhes(h, n, fac, nn)
                integer(kind=int32) intent(in) :: n
                real(kind=real64) intent(in,out), dimension(n, n) :: h
                real(kind=real64) intent(out), dimension(n) :: fac
                integer(kind=int32) intent(out) :: nn
            end subroutine norhes
            subroutine heseig(a, n, nrt, x, xp, eig, eta, nzc, ierr)
                integer(kind=int32) intent(in) :: n, nrt, nzc
                real(kind=real64) intent(in), dimension(n, n) :: a
                real(kind=real64) intent(in) :: eta
                real(kind=real64) intent(in,out), dimension(n) :: x, xp
                real(kind=real64) intent(out), dimension(nrt) :: eig
                integer(kind=int32) intent(out) :: ierr
            end subroutine heseig
            subroutine hesvec(h, n, nn, scr, root, eta, scrv, vec, ierr)
                integer(kind=int32) intent(in) :: n, nn
                real(kind=real64) intent(in), dimension(n, n) :: h
                real(kind=real64) intent(in) :: root, eta
                real(kind=real64) intent(in,out), dimension(nn, nn) :: scr
                real(kind=real64) intent(in,out), dimension(nn) :: scrv
                real(kind=real64) intent(out), dimension(n) :: vec
                integer(kind=int32) intent(out) :: ierr
            end subroutine hesvec
            subroutine cdct(c, d, dd, nvec, nbas, n2bas)
                integer(kind=int32) optional, depend(c) :: nbas = shape(c, 0)
                integer(kind=int32) optional, depend(c) :: nvec = shape(c, 1)
                integer(kind=int32) optional, depend(nbas) :: n2bas = (nbas*(nbas+1))/2
                real(kind=real64) intent(in), dimension(nbas, nvec) :: c
                real(kind=real64) intent(in), dimension(nvec), depend(nvec) :: d
                real(kind=real64) intent(out), dimension(n2bas), depend(n2bas) :: dd
            end subroutine cdct
            subroutine ctsc(c, s, scrat, ss, nbas, nvec)
                integer(kind=int32) optional, depend(c) :: nbas = shape(c, 0)
                integer(kind=int32) optional, depend(c) :: nvec = shape(c, 1)
                real(kind=real64) intent(in), dimension(nbas, nvec) :: c
                real(kind=real64) intent(in), dimension((nbas*(nbas+1))/2), depend(nbas) :: s
                real(kind=real64) intent(out), dimension(nbas, nvec), depend(nbas, nvec) :: scrat
                real(kind=real64) intent(out), dimension((nvec*(nvec+1))/2), depend(nvec) :: ss
            end subroutine ctsc
            subroutine pcct(p, c, psinv, nvec, nbas, n2bas)
                integer(kind=int32) optional, depend(c) :: nbas = shape(c, 0)
                integer(kind=int32) optional, depend(c) :: nvec = shape(c, 1)
                integer(kind=int32) optional, depend(nbas) :: n2bas = (nbas*(nbas+1))/2
                real(kind=real64) intent(in), dimension(n2bas) :: p
                real(kind=real64) intent(in), dimension(nbas, nvec) :: c
                real(kind=real64) intent(out), dimension(nbas, nbas), depend(nbas) :: psinv
            end subroutine pcct
            subroutine insert(block, supmat, i, j, nrow, ncol)
                integer(kind=int32) optional, depend(block) :: nrow = shape(block, 0)
                integer(kind=int32) optional, depend(block) :: ncol = shape(block, 1)
                integer(kind=int32) intent(in) :: i, j
                real(kind=real64) intent(in), dimension(nrow, ncol) :: block
                real(kind=real64) intent(in,out), dimension(*) :: supmat
            end subroutine insert
            subroutine insrtd(block, supmat, i, n)
                integer(kind=int32) intent(in) :: i, n
                real(kind=real64) intent(in), dimension((n*(n+1))/2) :: block
                real(kind=real64) intent(in,out), dimension(*) :: supmat
            end subroutine insrtd
        end module linalg

        module symmetry
            use iso_fortran_env, only: real64, int32
            subroutine genrot(alpha, beta, gamma, rotate)
                real(kind=real64) intent(in) :: alpha, beta, gamma
                real(kind=real64) intent(out), dimension(3, 3) :: rotate
            end subroutine genrot
            subroutine sympak(a, asym, n, n2)
                integer(kind=int32) optional, depend(a) :: n = shape(a, 0)
                integer(kind=int32) optional, depend(n) :: n2 = (n*(n+1))/2
                real(kind=real64) intent(in), dimension(n, n) :: a
                real(kind=real64) intent(out), dimension(n2), depend(n2) :: asym
            end subroutine sympak
            subroutine sympro(a, b, scrat, nbas, n2bas, icode)
                integer(kind=int32) intent(in) :: icode
                integer(kind=int32) optional, depend(b) :: nbas = shape(b, 0)
                integer(kind=int32) optional, depend(a) :: n2bas = shape(a, 0)
                real(kind=real64) intent(in,out), dimension(n2bas) :: a
                real(kind=real64) intent(in), dimension(nbas, nbas) :: b
                real(kind=real64) intent(out), dimension(n2bas), depend(n2bas) :: scrat
            end subroutine sympro
            subroutine sympr1(p, r, s, f, scrat, n, n2)
                integer(kind=int32) intent(in) :: n
                integer(kind=int32) optional, depend(p) :: n2 = shape(p, 0)
                real(kind=real64) intent(in), dimension(n2) :: p, r, s
                real(kind=real64) intent(out), dimension(n2), depend(n2) :: f
                real(kind=real64) intent(out), dimension(n, n), depend(n) :: scrat
            end subroutine sympr1
            subroutine sympr2(p, r, s, scrat1, scrat2, n, n2)
                integer(kind=int32) intent(in) :: n
                integer(kind=int32) optional, depend(p) :: n2 = shape(p, 0)
                real(kind=real64) intent(in), dimension(n2) :: p, s
                real(kind=real64) intent(in,out), dimension(n2) :: r
                real(kind=real64) intent(out), dimension(n, n), depend(n) :: scrat1, scrat2
            end subroutine sympr2
        end module symmetry

        module density
            use iso_fortran_env, only: real64, int32
            subroutine denmat(dens, evec, occ, nbas, n2bas, nvec)
                integer(kind=int32) optional, depend(evec) :: nbas = shape(evec, 0)
                integer(kind=int32) optional, depend(nbas) :: n2bas = (nbas*(nbas+1))/2
                integer(kind=int32) optional, depend(evec) :: nvec = shape(evec, 1)
                real(kind=real64) intent(in), dimension(nbas, nvec) :: evec
                real(kind=real64) intent(in), dimension(nvec), depend(nvec) :: occ
                real(kind=real64) intent(out), dimension(n2bas), depend(n2bas) :: dens
            end subroutine denmat
            subroutine chrgbo(dens, ovlp, popul, totpop, nbas, n2bas)
                integer(kind=int32) intent(in) :: nbas
                integer(kind=int32) optional, depend(dens) :: n2bas = shape(dens, 0)
                real(kind=real64) intent(in,out), dimension(n2bas) :: dens
                real(kind=real64) intent(in), dimension(n2bas), depend(n2bas) :: ovlp
                real(kind=real64) intent(out), dimension(nbas), depend(nbas) :: popul
                real(kind=real64) intent(out) :: totpop
            end subroutine chrgbo
            subroutine mulpop(dens, ovlp, popul, totpop, nbas, n2bas)
                integer(kind=int32) intent(in) :: nbas
                integer(kind=int32) optional, depend(dens) :: n2bas = shape(dens, 0)
                real(kind=real64) intent(in,out), dimension(n2bas) :: dens
                real(kind=real64) intent(in), dimension(n2bas), depend(n2bas) :: ovlp
                real(kind=real64) intent(out), dimension(nbas), depend(nbas) :: popul
                real(kind=real64) intent(out) :: totpop
            end subroutine mulpop
            subroutine lowdin_pop(dens, ovlp, popul, totpop, nbas, n2bas)
                integer(kind=int32) intent(in) :: nbas
                integer(kind=int32) optional, depend(dens) :: n2bas = shape(dens, 0)
                real(kind=real64) intent(in), dimension(n2bas) :: dens
                real(kind=real64) intent(in), dimension(n2bas), depend(n2bas) :: ovlp
                real(kind=real64) intent(out), dimension(nbas), depend(nbas) :: popul
                real(kind=real64) intent(out) :: totpop
            end subroutine lowdin_pop
            function averag(onemat, denmat, nbas, n2bas) result(val)
                integer optional, depend(onemat) :: n2bas = shape(onemat, 0)
                integer optional, depend(n2bas) :: nbas = (int)(sqrt(8.0*n2bas+1.0)-1.0)/2
                double precision intent(in), dimension(n2bas) :: onemat, denmat
                double precision :: val
            end function averag
            subroutine occmet(ontran, occ, stovl, norb, n2orb)
                integer(kind=int32) optional, depend(ontran) :: norb = shape(ontran, 0)
                integer(kind=int32) optional, depend(norb) :: n2orb = (norb*(norb+1))/2
                real(kind=real64) intent(in,out), dimension(norb, norb) :: ontran
                real(kind=real64) intent(in), dimension(norb), depend(norb) :: occ
                real(kind=real64) intent(out), dimension(n2orb), depend(n2orb) :: stovl
            end subroutine occmet
            subroutine neword(vector, scrat, iorder, nbas)
                integer(kind=int32) optional, depend(vector) :: nbas = shape(vector, 0)
                real(kind=real64) intent(in,out), dimension(nbas) :: vector
                real(kind=real64) intent(out), dimension(nbas), depend(nbas) :: scrat
                integer(kind=int32) intent(in), dimension(nbas), depend(nbas) :: iorder
            end subroutine neword
            subroutine wfct(w, s, nmx, nmnm1, n1, eta1, n2, eta2)
                integer(kind=int32) intent(in) :: nmx, nmnm1, n1, n2
                real(kind=real64) intent(in) :: eta1, eta2
                real(kind=real64) intent(out), dimension(nmnm1), depend(nmnm1) :: w
                real(kind=real64) intent(out), dimension(nmx), depend(nmx) :: s
            end subroutine wfct
            subroutine sfct(s, nu, mumxp1, alpha)
                integer(kind=int32) intent(in) :: nu, mumxp1
                real(kind=real64) intent(in) :: alpha
                real(kind=real64) intent(out), dimension(mumxp1), depend(mumxp1) :: s
            end subroutine sfct
        end module density

        module diagnostics
            function noble(nucz) result(val)
                integer intent(in) :: nucz
                integer :: val
            end function noble
            function mapndx(x, mapdim) result(idx)
                double precision intent(in) :: x
                integer intent(in) :: mapdim
                integer :: idx
            end function mapndx
        end module diagnostics

        module exchange_dft
            use iso_fortran_env, only: real64, int32
            subroutine eval_exchange_potential_point(rho, drho, exch_type, alpha, vx, fx)
                real(kind=real64) intent(in) :: rho, drho
                integer(kind=int32) intent(in) :: exch_type
                real(kind=real64) intent(in) :: alpha
                real(kind=real64) intent(out) :: vx, fx
            end subroutine eval_exchange_potential_point
            subroutine compute_dft_exchange(ielem, stden, stexch, exch_type_in, exch_alpha_in, m2sto, ispin)
                use state, only: M2STO, ISPIN
                integer(kind=int32) intent(in) :: ielem
                integer(kind=int32) optional, depend(stden) :: m2sto = shape(stden, 0)
                integer(kind=int32) optional, depend(stden) :: ispin = shape(stden, 1)
                real(kind=real64) intent(in), dimension(m2sto, ispin) :: stden
                real(kind=real64) intent(out), dimension(m2sto, ispin), depend(m2sto, ispin) :: stexch
                integer(kind=int32) optional, intent(in) :: exch_type_in = 1
                real(kind=real64) optional, intent(in) :: exch_alpha_in = 0.6666666666666666
            end subroutine compute_dft_exchange
            subroutine fit_exchange_exponential(n_grid, r_grid, vx_grid, w_grid, n_terms, vexp, vcoef, rms)
                integer(kind=int32) optional, depend(r_grid) :: n_grid = shape(r_grid, 0)
                real(kind=real64) intent(in), dimension(n_grid) :: r_grid
                real(kind=real64) intent(in), dimension(n_grid), depend(n_grid) :: vx_grid
                real(kind=real64) intent(in), dimension(n_grid), depend(n_grid) :: w_grid
                integer(kind=int32) optional, depend(vexp) :: n_terms = shape(vexp, 0)
                real(kind=real64) intent(in), dimension(n_terms) :: vexp
                real(kind=real64) intent(out), dimension(n_terms), depend(n_terms) :: vcoef
                real(kind=real64) intent(out) :: rms
            end subroutine fit_exchange_exponential
        end module exchange_dft
    end interface
end python module _phatpsy_core
